# Jobbot Enterprise. Copy to .env. Never commit .env.
# Operator token that may create tenants (POST /v1/tenants). Generate a long random value.
JOBBOT_OPERATOR_TOKEN=change-me
# SQLite path inside the container volume (data stays in your infrastructure).
JOBBOT_DB_PATH=/data/jobbot.db
# Origins allowed to embed the widget, comma-separated.
JOBBOT_CORS_ORIGINS=https://careers.example.com
